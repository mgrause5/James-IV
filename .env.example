# ---------------------------------------------------------------------------
# Resy credentials. Copy to .env and fill in. .env is gitignored -- keep it so.
# ---------------------------------------------------------------------------

RESY_EMAIL=you@example.com
RESY_PASSWORD=your-resy-password

# Optional: use a browser auth token instead of email/password.
# resy.com -> devtools -> Network -> any api.resy.com request ->
# copy the X-Resy-Auth-Token request header.
# Tokens expire eventually and cannot be auto-refreshed; email/password is
# better for a long-running bot.
# RESY_AUTH_TOKEN=

# Optional: pin the payment method used for booking. Leave blank to use the
# default card on your Resy account (found automatically at login).
# RESY_PAYMENT_METHOD_ID=

# Optional: override the public web API key, if Resy rotates it.
# Find it in devtools: Authorization: ResyAPI api_key="..."
# RESY_API_KEY=

# ---------------------------------------------------------------------------
# Notifications -- configure at least one, or you will only see the log.
# ---------------------------------------------------------------------------

# ntfy (free, no account): pick an unguessable topic name, then subscribe to
# the same topic in the ntfy app on your phone. Anyone who knows the topic can
# read it, so make it random.
NTFY_TOPIC=james-iv-change-me-to-something-random
NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Pushover (paid one-time, more reliable delivery)
# PUSHOVER_TOKEN=
# PUSHOVER_USER=

# ---------------------------------------------------------------------------
# Guest details for DoorDash/SevenRooms venues (The Corner Store, The Eighty
# Six, ...). These bookings are account-less: the reservation is placed under
# this name, and the confirmation email goes to this address.
# ---------------------------------------------------------------------------
GUEST_FIRST_NAME=
GUEST_LAST_NAME=
GUEST_PHONE=+12125551234
# GUEST_EMAIL=            # defaults to RESY_EMAIL if blank

# ---------------------------------------------------------------------------
# Residential proxy -- the fix for datacenter-IP throttling. Sign up with a
# residential-proxy provider, paste the gateway URL they give you here, and
# set aggressive_polling: true in config.yaml. Format:
#   PROXY_URL=http://username:password@gateway.provider.com:7000
# Leave blank to run direct (fine for testing; gets throttled for real drops).
# ---------------------------------------------------------------------------
PROXY_URL=
