<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- MG Macros ribbon tab for PowerPoint.
     Embed this part into MGMacros.ppam (or your .pptm) with
     Install-MGRibbon.ps1 or the Office RibbonX Editor. Buttons call
     MG_RibbonAction in PPT_MGRibbon.bas.
     Keyboard: Alt, X opens the tab. Grab Size is a dropdown:
     Alt, X, S opens it, then W grabs the width, H the height,
     B both. Alt, X, A applies whatever was grabbed.
     Caveat: if a legacy COM add-in makes the built-in Add-ins tab
     visible, that tab also claims the X keytip and Office reassigns
     the duplicate - pick another tab letter here if Alt, X ever
     opens "Add-ins" instead. -->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon startFromScratch="false">
    <tabs>
      <tab id="mgTab" label="MG Macros" keytip="X" insertAfterMso="TabHome">
        <group id="mgSize" label="Size">
          <menu id="mgGrabMenu" label="Grab Size" size="large"
                imageMso="Copy" keytip="S"
                screentip="Grab this shape's dimensions"
                supertip="Opens a chooser: grab the width, the height, or both. Each grab replaces the previous one. Select exactly one shape first.">
            <button id="mgGrabW" label="Grab Width" imageMso="SizeToControlWidth" keytip="W"
                    screentip="Remember only this shape's width"
                    onAction="MG_RibbonAction"/>
            <button id="mgGrabH" label="Grab Height" imageMso="SizeToControlHeight" keytip="H"
                    screentip="Remember only this shape's height"
                    onAction="MG_RibbonAction"/>
            <button id="mgGrabB" label="Grab Both" imageMso="SizeToControlHeightAndWidth" keytip="B"
                    screentip="Remember this shape's width and height"
                    onAction="MG_RibbonAction"/>
          </menu>
          <button id="mgApply" label="Apply" size="large"
                  imageMso="Paste" keytip="A"
                  screentip="Give the selected shapes whatever was grabbed"
                  supertip="Applies exactly the dimensions you grabbed - width, height, or both."
                  onAction="MG_RibbonAction"/>
          <button id="mgApplyW" label="Apply Width" size="normal"
                  imageMso="SizeToControlWidth" keytip="W"
                  screentip="Give the grabbed width to the selected shapes"
                  onAction="MG_RibbonAction"/>
          <button id="mgApplyH" label="Apply Height" size="normal"
                  imageMso="SizeToControlHeight" keytip="H"
                  screentip="Give the grabbed height to the selected shapes"
                  onAction="MG_RibbonAction"/>
        </group>
        <group id="mgArrange" label="Arrange">
          <button id="mgSwap" label="Swap Shapes" size="large"
                  imageMso="ObjectFlipHorizontal" keytip="P"
                  screentip="Two selected shapes trade places"
                  supertip="Centers swap, so different-sized shapes stay balanced in each other's spot."
                  onAction="MG_RibbonAction"/>
          <button id="mgSwapTL" label="Swap Corners" size="normal"
                  imageMso="ObjectFlipVertical" keytip="L"
                  screentip="Two selected shapes trade top-left corners"
                  onAction="MG_RibbonAction"/>
        </group>
        <group id="mgTBU" label="TBU">
          <button id="mgTBUAdd" label="TBU Marker" size="large"
                  imageMso="TextBoxInsert" keytip="T"
                  screentip="Drop a pre-formatted TBU flag"
                  supertip="Pinned to the selected shape's top-right corner, or the slide's when nothing is selected."
                  onAction="MG_RibbonAction"/>
          <button id="mgTBUClearSlide" label="Clear Slide" size="normal"
                  imageMso="Delete" keytip="D"
                  screentip="Remove every TBU marker on this slide"
                  onAction="MG_RibbonAction"/>
          <button id="mgTBUClearDeck" label="Clear Deck" size="normal"
                  imageMso="Delete" keytip="K"
                  screentip="Remove every TBU marker in the presentation"
                  onAction="MG_RibbonAction"/>
        </group>
        <group id="mgRider" label="Rider">
          <button id="mgRiderSend" label="Copy to Rider" size="large"
                  imageMso="FileSaveAs" keytip="C"
                  screentip="Copy this slide into the deck's rider file"
                  supertip="Creates the rider on first use and appends on every use after that."
                  onAction="MG_RibbonAction"/>
          <button id="mgRiderMove" label="Move to Rider" size="large"
                  imageMso="Cut" keytip="M"
                  screentip="Rip this slide out into the rider"
                  supertip="The slide is deleted from this deck only after the rider has saved successfully."
                  onAction="MG_RibbonAction"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
